#!/bin/sh
# Auto-update the active AgentCore skill record on every push.
# (The record itself is created/closed by the agent internally — you never
#  need to run `skill start` / `skill finish`.)
state=".agentcore/state/skill_active_task"
if [ -f "$state" ]; then
  task_id="$(tr -d '[:space:]' < "$state")"
  if [ -n "$task_id" ]; then
    python -m src.cli skill update "$task_id" --message "git push (auto)" >/dev/null 2>&1 || true
  fi
fi
exit 0
