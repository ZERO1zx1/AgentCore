{
  "name": "@agentcore/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types and contracts for AgentCore",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}
