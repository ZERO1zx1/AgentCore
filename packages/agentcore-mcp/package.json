  },
  "dependencies": {
    "@agentcore/types": "file:../agentcore-types",
    "@agentcore/assistant": "file:../agentcore-assistant",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0"
  }
}
