{
  "name": "@agentcore/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP Server for AgentCore - Tools and resources for repository inspection, task execution, and monitoring",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
